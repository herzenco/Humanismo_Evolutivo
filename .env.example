# Spanish-only release switches. Unset and "false" keep the surface hidden.
# Set either value to true and redeploy to turn that surface back on. No routes are deleted.
NEXT_PUBLIC_PORTAL_ENABLED=false
NEXT_PUBLIC_EN_ENABLED=false

# Configure distinct values for Vercel Preview and Production.
SITE_URL=https://yosoynosotros.org
NEXT_PUBLIC_SITE_URL=https://yosoynosotros.org

# Public Supabase browser configuration. Prefer the modern sb_publishable_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only; not needed when the publishable key is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

OCC_CONTENT_PROPERTY=humanismo-evolutivo
OCC_CONTENT_API_URL=https://operations.example.com/api/v1/content
OCC_CONTENT_API_TOKEN=
# QA-only opt-in: use the committed Resources snapshot when OCC config is absent.
OCC_RESOURCES_ALLOW_SNAPSHOT=false
OCC_PUBLISH_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# Enable school infrastructure only in the QA deployment, after its migration.
EDUCATION_ACCESS_ENVIRONMENT=

# Server-only email delivery for school invitations. No service-role key is needed.
# Configure a verified sender/domain with the email provider before enabling sends.
RESEND_API_KEY=
PORTAL_INVITATION_FROM=humanismoevolutivo@gmail.com
# Sender for contact notifications.
CONTACT_FROM_EMAIL=

# Approved public contact number in international format, including country code.
CONTACT_PUBLIC_PHONE=

# Unlisted YouTube video IDs. Add caption tracks in YouTube Studio before setting these.
NEXT_PUBLIC_HE_INTRODUCTION_YOUTUBE_ID=
NEXT_PUBLIC_HE_PHILOSOPHERS_YOUTUBE_ID=
NEXT_PUBLIC_HE_TUTORIAL_YOUTUBE_ID=

NEWSLETTER_ENVIRONMENT=
NEWSLETTER_SUPABASE_URL=
NEWSLETTER_SUPABASE_PUBLISHABLE_KEY=
NEWSLETTER_FROM_EMAIL=
RESEND_NEWSLETTER_SEGMENT_ID=

# Isolated QA resource catalog. Keep the main site's public Supabase connection separate.
QA_RESOURCE_SUPABASE_PUBLISHABLE_KEY=
# Server-only reader token (64 hexadecimal characters).
QA_RESOURCE_READER_TOKEN=
