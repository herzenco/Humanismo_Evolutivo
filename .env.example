# Configure distinct values for Vercel Preview and Production.
SITE_URL=https://yosoynosotros.org
NEXT_PUBLIC_SITE_URL=https://yosoynosotros.org

# Public Supabase browser configuration. Prefer the modern sb_publishable_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only; not needed when the publishable key is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

OCC_CONTENT_PROPERTY=humanismo-evolutivo
OCC_CONTENT_API_URL=https://operations.example.com/api/v1/content
OCC_CONTENT_API_TOKEN=
# QA-only opt-in: use the committed Resources snapshot when OCC config is absent.
OCC_RESOURCES_ALLOW_SNAPSHOT=false
OCC_PUBLISH_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# Enable school infrastructure only in the QA deployment, after its migration.
EDUCATION_ACCESS_ENVIRONMENT=
