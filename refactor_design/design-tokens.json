{
  "name": "Humanismo Evolutivo — refactor 2026",
  "breakpoints": {
    "laptop": { "width": 1440, "contentWidth": 1200, "gutter": 120 },
    "ipad": { "width": 834, "contentWidth": 754, "gutter": 40 },
    "iphone": { "width": 390, "contentWidth": 350, "gutter": 20 }
  },
  "color": {
    "forest": "#173F2C",
    "forestDeep": "#0F2E20",
    "cardOnDark": "#1F4B36",
    "green": "#2F6B45",
    "moss": "#6E9A45",
    "sage": "#EAF0E1",
    "sageLight": "#F4F7EF",
    "line": "#DCE5D2",
    "lineSoft": "#E1E7D8",
    "fieldBorder": "#CBD6C0",
    "ivory": "#FAF7EF",
    "portalGround": "#F7F5EF",
    "white": "#FFFFFF",
    "ink": "#1D2B22",
    "body": "#3E4D43",
    "muted": "#4A5A4F",
    "gold": "#D4AF5A",
    "goldTextOnLight": "#7A5C18",
    "progressTrack": "#E6EBDD",
    "supporting": {
      "portalLine": "#EDF0E6",
      "portalCanvas": "#FAFAF6",
      "portalInk": "#2A3A30",
      "warmWhite": "#FFFDF7",
      "softLine": "#DDE5D3",
      "softLineStrong": "#D3DEC6",
      "greenTint": "#E2EFE0",
      "greenTintBorder": "#B3D3B1",
      "greenTintText": "#1D4A2E",
      "greenTintMuted": "#D7E4DF",
      "confirmationTint": "#DFE9D2",
      "confirmationBorder": "#CADBBB",
      "confirmationSoft": "#EEF2E7",
      "confirmationText": "#C7D8D1",
      "warmNeutral": "#EFE8D6",
      "warmNeutralBorder": "#DCD3BC",
      "warmNeutralStrong": "#D8C9A0"
    },
    "semantic": {
      "focus": {
        "onLight": "#2F6B45",
        "onDark": "#D4AF5A",
        "offsetLight": "#FFFFFF",
        "offsetDark": "#173F2C",
        "usage": "2px visible focus ring plus 2px offset; never remove focus without a replacement"
      },
      "success": {
        "text": "#1F5A3A",
        "background": "#DBE9DE",
        "border": "#B2CFBA"
      },
      "warning": {
        "text": "#5A4310",
        "accent": "#B08419",
        "background": "#F6ECD4",
        "backgroundSoft": "#FBF3DC",
        "border": "#E4CF9C",
        "borderSoft": "#EAD7A4"
      },
      "error": {
        "text": "#9A3A2E",
        "textStrong": "#7A2615",
        "textDeep": "#6B2A1C",
        "accent": "#9B3520",
        "background": "#FBEEEA",
        "border": "#E6C4BE",
        "borderStrong": "#EBC9BE"
      },
      "disabled": {
        "text": "#9AA89E",
        "background": "#EDF0E6",
        "border": "#DDE5D3"
      }
    },
    "calendarCourses": {
      "identidadCivismo": { "accent": "#B08419", "background": "#F6ECD4", "border": "#E4CF9C" },
      "ecologiaEspiritualidad": { "accent": "#7C9A2A", "background": "#EAF1D6", "border": "#CFDDA8" },
      "historiaArte": { "accent": "#2B7A6D", "background": "#DDEEEA", "border": "#B6D8D0" },
      "humanismoEvolutivo": { "accent": "#1F5A3A", "background": "#DBE9DE", "border": "#B2CFBA" },
      "introduccionFilosofia": { "accent": "#6953A0", "background": "#E9E5F4", "border": "#CDC4E6" },
      "yoSoyNosotros": { "accent": "#A0487A", "background": "#F5E1EB", "border": "#E3BFD1" },
      "antropologia": { "accent": "#7D4A8A", "background": "#EFE3F0", "border": "#D8C2DB" },
      "filosofiaNinos": { "accent": "#4659A6", "background": "#E1E7F5", "border": "#C3CEEA" },
      "religionesLectura": { "accent": "#2F6F9B", "background": "#DDEBF4", "border": "#B9D5E8" },
      "serEmpresario": { "accent": "#B55E27", "background": "#F7E5D8", "border": "#E9C6AC" },
      "accessibility": "Course names must accompany color in legends and details; color is never the only identifier."
    },
    "usage": {
      "gold": "accents on dark grounds only (eyebrows, buttons, number circles on forest)",
      "goldTextOnLight": "the only gold allowed as text on light grounds",
      "sections": "alternate ivory / sage; forest for hero, emphasis bands, header and footer"
    }
  },
  "font": {
    "display": { "family": "Cormorant Garamond", "weights": [500, 600, 700], "italic": [500, 600], "use": "headings, display, quotes" },
    "label": { "family": "Cinzel", "weights": [500, 600], "use": "uppercase eyebrows and small caps labels (letter-spacing .12–.2em), Roman numerals, the CONOCER band" },
    "text": { "family": "Source Sans 3", "weights": [400, 600, 700], "use": "body, UI, buttons, forms" },
    "numerals": "font-variant-numeric: lining-nums everywhere; never set Arabic digits in Cinzel (its 1 reads as a Roman I) — use Cormorant Garamond 700 or Source Sans 3",
    "googleFontsCss": "https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;600;700&display=swap"
  },
  "typeScale": {
    "laptop": { "h1": "72–84px / 1.0", "h2": "46px", "h3": "28–38px", "lead": "19–20px", "body": "17px / 1.6", "small": "14–15px" },
    "ipad": { "h1": "56–64px / 1.02", "h2": "38–40px", "h3": "26–30px", "lead": "19px", "body": "17px / 1.6", "small": "14px" },
    "iphone": { "h1": "44–48px / 1.05", "h2": "32–34px", "h3": "24–26px", "lead": "18px", "body": "16–17px / 1.6", "small": "14px (minimum)" }
  },
  "spacing": {
    "sectionPadding": { "laptop": "112px 120px", "ipad": "80px 40px", "iphone": "56px 20px" },
    "heroPadding": { "laptop": "72px 120px 112px", "ipad": "56px 40px 80px", "iphone": "40px 20px 56px" },
    "readingColumnMax": "680–720px"
  },
  "radius": { "card": "16–28px", "image": "16–18px", "pill": "999px", "field": "12px", "cover": "6px", "arch": "160px 160px 18px 18px" },
  "components": {
    "buttonPrimary": { "height": { "laptop": 56, "ipad": 54, "iphone": 52 }, "background": "#2F6B45", "color": "#FFFFFF", "radius": "999px", "font": "Source Sans 3 700 16–17px" },
    "buttonOnDark": { "background": "#D4AF5A", "color": "#173F2C" },
    "buttonSecondary": { "border": "1.5px solid #2F6B45 (on dark: rgba(255,255,255,.6))", "color": "#2F6B45" },
    "chip": { "background": "#EAF0E1", "color": "#2F6B45", "font": "13–14px 600", "radius": "999px" },
    "numberCircle": { "size": { "laptop": 64, "ipad": 56, "iphone": 48 }, "background": "#173F2C", "color": "#FFFFFF", "font": "Cormorant Garamond 700, lining-nums" },
    "field": { "height": 52, "border": "1px solid #CBD6C0", "radius": "12px (single search/email fields: 999px)", "label": "14px 600 above the field" },
    "bookCover": { "sizing": "fixed width, height auto (never crop)", "radius": "6px", "shadow": "0 8px 18px rgba(23,63,44,0.18)" },
    "touchTarget": "≥ 44px"
  },
  "imagery": {
    "illustrationsIntact": ["assets/de-donde-venimos.jpg", "assets/hacia-donde-podemos-evolucionar.jpg"],
    "rule": "the two illustrations have baked-in text: never crop, overlay or recolor; object-fit: contain; keep aspect ratio",
    "lowRes": ["jardin-evolucion", "jardin-meditacion", "jardin-filosofia", "estatua", "socrates", "platon", "aristoteles", "logo-parque", "qr"],
    "avoid": "no stock photos, no gradient washes, no left-border accent cards, no emoji"
  }
}
